// 复用 NexT 7 的 CSS 变量。原生 darkmode 只跟随系统，这里统一处理手动选择。
blog-light-colors() {
  color-scheme: light;
  --body-bg-color: #f2f5f7;
  --content-bg-color: #fff;
  --card-bg-color: #f5f8fa;
  --text-color: #34434f;
  --blockquote-color: #637582;
  --link-color: #415867;
  --link-hover-color: #167d8d;
  --brand-color: #f4f9fc;
  --brand-hover-color: #9ce3df;
  --table-row-odd-bg-color: #f5f8fa;
  --table-row-hover-bg-color: #edf4f5;
  --menu-item-bg-color: #eaf3f4;
  --btn-default-bg: #fff;
  --btn-default-color: #167d8d;
  --btn-default-border-color: #167d8d;
  --btn-default-hover-bg: #167d8d;
  --btn-default-hover-color: #fff;
  --btn-default-hover-border-color: #167d8d;
  --blog-accent: #167d8d;
  --blog-muted: #6c7c89;
  --blog-border: #dce5eb;
  --blog-header-bg: #263b4a;
  --blog-inline-code-bg: #edf3f6;
  --blog-shadow: 0 4px 20px rgba(33, 57, 73, .06);
  --diagram-bg: #f8fbfc;
  --diagram-node-bg: #e7f2f2;
  --diagram-node-border: #81a8ae;
  --diagram-text: #2c424e;
  --diagram-line: #526e7c;
  --diagram-note-bg: #f3f0df;
  --diagram-note-border: #b3a875;
}

blog-dark-colors() {
  color-scheme: dark;
  --body-bg-color: #151c25;
  --content-bg-color: #202a36;
  --card-bg-color: #26323f;
  --text-color: #d5dee7;
  --blockquote-color: #acbdcb;
  --link-color: #bacddb;
  --link-hover-color: #79d8ce;
  --brand-color: #ecf4fa;
  --brand-hover-color: #79d8ce;
  --table-row-odd-bg-color: #25313e;
  --table-row-hover-bg-color: #2c3d4a;
  --menu-item-bg-color: #2c414b;
  --btn-default-bg: #202a36;
  --btn-default-color: #79d8ce;
  --btn-default-border-color: #5baaa6;
  --btn-default-hover-bg: #79d8ce;
  --btn-default-hover-color: #151c25;
  --btn-default-hover-border-color: #79d8ce;
  --blog-accent: #79d8ce;
  --blog-muted: #9bafbf;
  --blog-border: #3a4a5a;
  --blog-header-bg: #1b303e;
  --blog-inline-code-bg: #2c3b49;
  --blog-shadow: 0 4px 20px rgba(0, 0, 0, .16);
  --diagram-bg: #1b2632;
  --diagram-node-bg: #2c4951;
  --diagram-node-border: #6aa7ae;
  --diagram-text: #e1edf3;
  --diagram-line: #a5bac9;
  --diagram-note-bg: #454532;
  --diagram-note-border: #a6a376;
}

:root {
  blog-light-colors();
}

// JS 不可用时也跟随系统；手动选择日间时不受系统深色模式干扰。
@media (prefers-color-scheme: dark) {
  :root:not([data-color-mode='light']) {
    blog-dark-colors();
  }
}

:root[data-color-mode='dark'] {
  blog-dark-colors();
}

// 补齐 NexT 7 中仍写死颜色的正文、目录、搜索框与边框。
.site-brand-container {
  background: var(--blog-header-bg);
}

.site-subtitle {
  color: #b8ccd7;
}

.post-block, .sidebar-inner, .header-inner, .comments, .pagination {
  box-shadow: var(--blog-shadow);
}

.post {
  box-shadow: none;
}

.posts-expand .post-meta, .post-meta a, .post-description, .site-description,
.site-state-item-name, .footer, .posts-collapse .post-meta {
  color: var(--blog-muted);
}

.post-body {
  h1, h2, h3, h4, th, td, blockquote {
    border-color: var(--blog-border);
  }

  :not(pre) > code {
    background: var(--blog-inline-code-bg);
    color: var(--text-color);
  }

  a, .exturl {
    color: var(--blog-accent);
    border-bottom-color: var(--blog-border);
  }

  // 高亮代码表格保持原来的语法配色。
  .highlight tr {
    background: transparent;
  }
}

.sidebar-nav li:hover, .sidebar-nav .sidebar-nav-active, .sidebar-nav .sidebar-nav-active:hover,
.post-toc .nav .active > a, .post-toc .nav .active-current > a:hover,
.menu-item-active a, .menu .menu-item a:hover {
  color: var(--blog-accent);
  border-bottom-color: var(--blog-accent);
}

.main-menu .menu-item-active a::after {
  background: var(--blog-accent);
}

.menu .menu-item .badge {
  background: var(--menu-item-bg-color);
  color: var(--blog-muted);
  text-shadow: none;
}

.site-state-item, .post-nav, .post-nav-item,
.posts-collapse .post-header {
  border-color: var(--blog-border);
}

.pagination .page-number.current {
  background: var(--blog-accent);
  border-color: var(--blog-accent);
  color: var(--content-bg-color);
}

.search-popup {
  .search-header {
    background: var(--menu-item-bg-color);
  }

  input.search-input, .popup-btn-close:hover .fa {
    color: var(--text-color);
  }

  input.search-input::placeholder, .search-icon, .popup-btn-close {
    color: var(--blog-muted);
  }

  p.search-result {
    border-color: var(--blog-border);
  }

  .search-keyword {
    color: var(--blog-accent);
    border-color: var(--blog-accent);
  }
}

// 开关与站名同行；仍使用原来的首页链接和移动端菜单。
.site-brand-row {
  align-items: center;
  display: flex;
  gap: 10px;
  justify-content: center;
}

.color-mode-toggle {
  background: #526879;
  border: 1px solid #718a9c;
  border-radius: 16px;
  cursor: pointer;
  flex: 0 0 48px;
  height: 28px;
  padding: 3px;
  width: 48px;

  &:focus-visible {
    outline: 2px solid #9ce3df;
    outline-offset: 4px;
  }

  &[aria-checked='true'] {
    background: #254e57;
    border-color: #6aa7ae;

    .color-mode-thumb {
      transform: translateX(20px);
    }

    .color-mode-sun {
      display: none;
    }

    .color-mode-moon {
      display: block;
    }
  }
}

.color-mode-thumb {
  align-items: center;
  background: #f0f6fa;
  border-radius: 50%;
  color: #294c60;
  display: flex;
  height: 20px;
  justify-content: center;
  transition: transform .18s ease;
  width: 20px;

  svg {
    fill: none;
    height: 15px;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 1.8;
    width: 15px;
  }

  .color-mode-moon {
    display: none;
  }
}

@media (prefers-reduced-motion: reduce) {
  .color-mode-thumb {
    transition: none;
  }
}
