@import 'color-mode';
@import 'notebooks';

// 侧栏邮箱复制按钮与 GitHub 入口保持相同的字号和间距。
.links-of-author .email-copy-button {
  background: transparent;
  border: 0;
  border-radius: 4px;
  box-sizing: border-box;
  color: var(--link-color);
  cursor: pointer;
  display: block;
  font-family: inherit;
  font-size: $font-size-smaller;
  line-height: inherit;
  margin: 0;
  padding: 0 5px;
  white-space: nowrap;
  width: 100%;

  &:hover {
    background: var(--body-bg-color);
    color: var(--link-hover-color);
  }

  &:focus-visible {
    outline: 2px solid var(--blog-accent);
    outline-offset: 2px;
  }

  &[data-copy-state='copied'] {
    color: var(--blog-accent);
  }
}

.email-copy-fallback {
  background: var(--card-bg-color);
  border: 1px solid var(--blog-border);
  border-radius: 6px;
  box-sizing: border-box;
  color: var(--text-color);
  font-size: $font-size-smaller;
  margin-top: 8px;
  padding: 8px;
  text-align: left;
  width: 100%;

  label {
    display: block;
  }

  input {
    background: var(--content-bg-color);
    border: 1px solid var(--blog-border);
    border-radius: 4px;
    box-sizing: border-box;
    color: var(--text-color);
    display: block;
    font: inherit;
    padding: 4px;
    width: 100%;

    &:focus {
      outline: 2px solid var(--blog-accent);
      outline-offset: 1px;
    }
  }
}

// 主页文章间距
.post {
   margin-top: 60px;
   padding: 20px;
   margin-bottom: 60px;
}

// Mermaid 配色随页面切换；宽图仍在图框内横向滚动。
.post-body pre.mermaid {
  background: var(--diagram-bg);
  border: 1px solid var(--blog-border);
  border-radius: 8px;
  box-sizing: border-box;
  color: var(--diagram-text);
  margin: 1.5em 0;
  overflow-x: auto;
  padding: 16px;
}

.post-body pre.mermaid svg {
  display: block;
  height: auto;
  margin: 0 auto;
}

// Mermaid 8 自带的 max-width 是图的原始宽度，小图仍按原尺寸显示。
.post-body pre.mermaid svg[width='100%'][style*='max-width'] {
  width: unquote('max(100%, 46rem)');
}

// Mermaid 8 的 SVG 带动态 ID 样式，使用 !important 覆盖默认配色。
// 只调整颜色，不重新渲染，切换时保留图的大小和横向滚动位置。
.post-body pre.mermaid {
  rect.actor, .labelBox, .activation0, .activation1, .activation2,
  .node rect, .node circle, .node ellipse, .node polygon, .node path {
    fill: var(--diagram-node-bg) !important;
    stroke: var(--diagram-node-border) !important;
  }

  text, text tspan, .messageText, .labelText, .loopText, .noteText,
  .nodeLabel, .edgeLabel, .label {
    color: var(--diagram-text) !important;
    fill: var(--diagram-text) !important;
  }

  .actor-line, line[id^='actor'], .messageLine0, .messageLine1, .loopLine,
  .flowchart-link, .edgePath .path {
    stroke: var(--diagram-line) !important;
  }

  marker path, marker circle, .arrowheadPath {
    fill: var(--diagram-line) !important;
    stroke: var(--diagram-line) !important;
  }

  .sequenceNumber {
    fill: var(--diagram-bg) !important;
  }

  .note {
    fill: var(--diagram-note-bg) !important;
    stroke: var(--diagram-note-border) !important;
  }

  .cluster rect {
    fill: var(--card-bg-color) !important;
    stroke: var(--blog-border) !important;
  }

  .edgeLabel, .edgeLabel rect, .edgeLabel span, .labelBkg {
    background: var(--diagram-bg) !important;
    fill: var(--diagram-bg) !important;
  }

  text.actor, .messageText {
    font-family: $font-family-posts !important;
  }

  text.actor {
    font-size: 16px !important;
    font-weight: 600 !important;
  }

  .messageText {
    stroke: none !important;
  }
}
