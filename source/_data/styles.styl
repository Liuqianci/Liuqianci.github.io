	// 主页文章添加阴影效果
.post {
   margin-top: 60px;
   padding: 20px;
   margin-bottom: 60px;
   -webkit-box-shadow: 0 0 5px rgba(120, 128, 114, 1.5);
   -moz-box-shadow: 0 0 5px rgba(202, 203, 204, .5);
}

// Mermaid 与正文共用浅色背景；宽图在图框内横向滚动。
.post-body pre.mermaid {
  background: #fff;
  border: 1px solid #dce2e6;
  border-radius: 8px;
  box-sizing: border-box;
  color: #26363d;
  margin: 1.5em 0;
  overflow-x: auto;
  padding: 16px;
}

.post-body pre.mermaid svg {
  display: block;
  height: auto;
  margin: 0 auto;
}

// Mermaid 8 自带的 max-width 是图的原始宽度，小图仍按原尺寸显示。
.post-body pre.mermaid svg[width='100%'][style*='max-width'] {
  width: unquote('max(100%, 46rem)');
}

// SVG 内的主题规则带有动态 ID；只覆盖时序图的参与者和消息文字。
.post-body pre.mermaid {
  rect.actor {
    fill: #e8f2f2 !important;
    stroke: #8aa9ae !important;
  }

  text.actor, .messageText {
    font-family: $font-family-posts !important;
  }

  text.actor {
    font-size: 16px !important;
    font-weight: 600 !important;
  }

  .messageText {
    stroke: none !important;
  }
}
